import requests
import time
import hmac
import hashlib
import json
from typing import Dict, List, Optional
from dataclasses import dataclass
from datetime import datetime
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


@dataclass
class TradeSignal:
    market_ticker: str
    side: str
    fair_price: float
    probability: float
    edge: float
    kelly_fraction: float
    timestamp: datetime


@dataclass
class Position:
    market_ticker: str
    side: str
    quantity: int
    avg_price: float
    current_value: float
    unrealized_pnl: float


class KalshiExecutor:
    BASE_URL = "https://trading-api.kalshi.com/trade-api/v2"
    
    def __init__(self, api_key: str, api_secret: str, demo_mode: bool = True):
        self.api_key = api_key
        self.api_secret = api_secret
        self.demo_mode = demo_mode
        
        if demo_mode:
            self.BASE_URL = "https://demo-api.kalshi.co/trade-api/v2"
            logger.info("🔶 Running in DEMO mode - no real money")
        
        self.session = requests.Session()
        self.balance = 0.0
        self.positions: Dict[str, Position] = {}
        self.max_position_pct = 0.15
        self.min_edge_threshold = 1.0
        
    def _sign_request(self, method: str, path: str, body: str = "") -> Dict[str, str]:
        timestamp = str(int(time.time() * 1000))
        message = timestamp + method + path + body
        signature = hmac.new(
            self.api_secret.encode(),
            message.encode(),
            hashlib.sha256
        ).hexdigest()
        
        return {
            "Content-Type": "application/json",
            "KALSHI-ACCESS-KEY": self.api_key,
            "KALSHI-ACCESS-SIGNATURE": signature,
            "KALSHI-ACCESS-TIMESTAMP": timestamp
        }
    
    def authenticate(self) -> bool:
        try:
            path = "/login"
            headers = self._sign_request("POST", path)
            
            response = self.session.post(
                f"{self.BASE_URL}{path}",
                headers=headers
            )
            response.raise_for_status()
            
            self.refresh_balance()
            logger.info(f"✅ Authenticated - Balance: ${self.balance:.2f}")
            return True
            
        except Exception as e:
            logger.error(f"❌ Authentication failed: {e}")
            return False
    
    def refresh_balance(self) -> float:
        try:
            path = "/portfolio/balance"
            headers = self._sign_request("GET", path)
            
            response = self.session.get(
                f"{self.BASE_URL}{path}",
                headers=headers
            )
            response.raise_for_status()
            
            data = response.json()
            self.balance = data.get("balance", 0) / 100
            return self.balance
            
        except Exception as e:
            logger.error(f"❌ Failed to get balance: {e}")
            return 0.0
    
    def get_market_orderbook(self, market_ticker: str) -> Dict:
        try:
            path = f"/markets/{market_ticker}/orderbook"
            headers = self._sign_request("GET", path)
            
            response = self.session.get(
                f"{self.BASE_URL}{path}",
                headers=headers
            )
            response.raise_for_status()
            
            orderbook = response.json()
            yes_bids = orderbook.get("yes", [])
            yes_asks = orderbook.get("yes", [])
            
            best_bid = max([b["price"] for b in yes_bids]) if yes_bids else 0
            best_ask = min([a["price"] for a in yes_asks]) if yes_asks else 100
            
            return {
                "best_bid": best_bid,
                "best_ask": best_ask,
                "spread": best_ask - best_bid,
                "mid_price": (best_bid + best_ask) / 2
            }
            
        except Exception as e:
            logger.error(f"❌ Failed to get orderbook for {market_ticker}: {e}")
            return {}
    
    def calculate_position_size(self, signal: TradeSignal, orderbook: Dict) -> int:
        if self.balance == 0:
            return 0
        
        kelly_size_dollars = self.balance * signal.kelly_fraction
        max_position_dollars = self.balance * self.max_position_pct
        position_dollars = min(kelly_size_dollars, max_position_dollars)
        
        price = orderbook["best_ask"] if signal.side == "yes" else (100 - orderbook["best_bid"])
        
        if price <= 0:
            return 0
        
        num_contracts = int(position_dollars * 100 / price)
        
        if num_contracts < 1:
            logger.info("📉 Position size too small, skipping")
            return 0
        
        logger.info(f"📊 Position size: {num_contracts} contracts")
        return num_contracts
    
    def place_limit_order(self, market_ticker: str, side: str, quantity: int, 
                         limit_price: float, time_in_force: str = "gtc") -> Optional[str]:
        try:
            path = "/portfolio/orders"
            
            order_data = {
                "ticker": market_ticker,
                "action": "buy" if side == "yes" else "sell",
                "side": side,
                "count": quantity,
                "type": "limit",
                "limit_price": int(limit_price),
                "time_in_force": time_in_force
            }
            
            body = json.dumps(order_data)
            headers = self._sign_request("POST", path, body)
            
            response = self.session.post(
                f"{self.BASE_URL}{path}",
                headers=headers,
                data=body
            )
            response.raise_for_status()
            
            result = response.json()
            order_id = result.get("order", {}).get("order_id")
            
            logger.info(f"✅ Order placed: {order_id} - {side.upper()} {quantity}x @ {limit_price}¢")
            return order_id
            
        except Exception as e:
            logger.error(f"❌ Failed to place order: {e}")
            return None
    
    def execute_signal(self, signal: TradeSignal, aggressive: bool = False) -> bool:
        logger.info(f"\\n{'='*60}")
        logger.info(f"🎯 EXECUTING SIGNAL for {signal.market_ticker}")
        logger.info(f"   Side: {signal.side.upper()} | Edge: {signal.edge:.2f}¢")
        
        if signal.edge < self.min_edge_threshold:
            logger.info(f"⏭️  Edge below threshold, skipping")
            return False
        
        orderbook = self.get_market_orderbook(signal.market_ticker)
        if not orderbook:
            logger.error("❌ Cannot get orderbook, aborting")
            return False
        
        logger.info(f"📖 Orderbook: Bid {orderbook['best_bid']}¢ | Ask {orderbook['best_ask']}¢")
        
        quantity = self.calculate_position_size(signal, orderbook)
        if quantity == 0:
            return False
        
        mid_price = orderbook["mid_price"]
        limit_price = min(mid_price, signal.fair_price)
        
        order_id = self.place_limit_order(
            signal.market_ticker,
            signal.side,
            quantity,
            limit_price,
            time_in_force="ioc"
        )
        
        if order_id:
            logger.info(f"✅ Trade executed successfully: {order_id}")
            return True
        else:
            logger.error("❌ Trade execution failed")
            return False
    
    def get_positions(self) -> List[Position]:
        try:
            path = "/portfolio/positions"
            headers = self._sign_request("GET", path)
            
            response = self.session.get(
                f"{self.BASE_URL}{path}",
                headers=headers
            )
            response.raise_for_status()
            
            positions_data = response.json().get("positions", [])
            
            positions = []
            for pos in positions_data:
                positions.append(Position(
                    market_ticker=pos["ticker"],
                    side=pos["side"],
                    quantity=pos["position"],
                    avg_price=pos["cost"] / pos["position"] if pos["position"] > 0 else 0,
                    current_value=pos["market_value"],
                    unrealized_pnl=pos["unrealized_pnl"]
                ))
            
            self.positions = {p.market_ticker: p for p in positions}
            return positions
            
        except Exception as e:
            logger.error(f"❌ Failed to get positions: {e}")
            return []
    
    def risk_check(self) -> bool:
        self.refresh_balance()
        
        if self.balance < 10:
            logger.warning("⚠️  Balance too low for trading")
            return False
        
        positions = self.get_positions()
        if len(positions) >= 5:
            logger.warning("⚠️  Too many open positions (max 5)")
            return False
        
        return True


